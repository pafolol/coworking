# Copia este archivo como .env y reinicia el backend.

# Google OAuth (inicio de sesión + Gmail). Ver README, sección "Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección pública del frontend; de aquí salen la URI de redirección y los enlaces de los formularios.
FRONTEND_URL=http://localhost:5180

# Opcional: correos que siempre pueden entrar como administradores (separados por coma).
ADMIN_EMAILS=

# 1 = carga equipos ficticios si la base está vacía. Pon 0 para arrancar en limpio.
SEED_DEMO=1

# 1 = deja el botón "modo demo" aunque Google ya esté configurado.
ALLOW_DEMO=0

# OpenAI: acomoda cualquier Excel o CSV al formato de importación (Importar datos).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Contraseña inicial de las cuentas admin y admin2 (se crean al arrancar si no existen).
LOGIN_PASSWORD=
